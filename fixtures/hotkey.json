      "name": "dictée simple, sans traduction",
      "line": 280,
      "fn": "hotkey_sequence",
      "args": {
        "hotkey": "right_option",
        "steps": [
          {
            "key": "right_option",
            "held": [
              "right_option"
            ]
          },
          {
            "key": "right_option",
            "held": []
          }
        ]
      },
      "expected": "PR"
    },
